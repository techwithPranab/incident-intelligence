NODE_ENV=development
API_PORT=4000
LOG_LEVEL=info
MONGODB_URI=mongodb://127.0.0.1:27017/incident_intelligence
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=incident-intelligence-api
JWT_AUDIENCE=incident-intelligence-web
JWT_EXPIRES_IN=15m
CORS_ORIGINS=http://localhost:3000
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
SERVICENOW_INSTANCE_URL=
SERVICENOW_CLIENT_ID=
SERVICENOW_CLIENT_SECRET=
SERVICENOW_AUTH_TYPE=oauth2
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=
SERVICENOW_PAGE_SIZE=100
SERVICENOW_MAX_RETRIES=5
SERVICENOW_FIELD_MAPPINGS_JSON=
SYNC_BATCH_SIZE=100
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AI_PROVIDER=openai
AI_CLASSIFICATION_PROMPT_VERSION=classification-v1
AI_RCA_PROMPT_VERSION=rca-v1
AI_MAX_INPUT_CHARACTERS=12000
MONGODB_VECTOR_INDEX=incident_embedding_vector
