{
  "name": "@incident-intelligence/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run",
    "seed:admin": "tsx src/scripts/seed-admin.ts",
    "seed:incidents": "tsx src/scripts/seed-incidents.ts"
    ,"embed:incidents": "tsx src/scripts/embed-incidents.ts",
    "embed:knowledge": "tsx src/scripts/embed-knowledge.ts"
    ,"sync:slas": "tsx src/scripts/sync-slas.ts"
  },
  "dependencies": {
    "@incident-intelligence/shared": "*",
    "@incident-intelligence/servicenow": "*",
    "@incident-intelligence/ai": "*",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.0.1",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.12.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.10",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.22.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript-eslint": "^8.26.0",
    "vitest": "^3.0.7"
  }
}
